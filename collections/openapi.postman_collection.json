    "_postman_id": "e7bea106-8439-4665-b810-7839d950d7dd",
    "name": "Google Voice API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Google Voice is a telecommunications service by Google that provides call forwarding, voicemail, text messaging, and voice calling. While Google Voice does not offer an official public REST API, the platform integrates with Google Workspace for business telephony. This specification documents the known endpoints and capabilities based on the Google Workspace Admin SDK and related voice management interfaces for provisioning and managing Google Voice services programmatically.\n\nContact Support:\n Name: Google Voice",
      "type": "text/plain"
    }
